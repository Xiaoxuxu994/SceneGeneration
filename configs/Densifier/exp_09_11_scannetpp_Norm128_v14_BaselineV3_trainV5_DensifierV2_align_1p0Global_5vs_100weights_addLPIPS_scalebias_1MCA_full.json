{
    "dataset_dir": "/efs-mi-east4-1/z84301856/datasets/scannetpp_v2_opencv_pinhole",
    "feats_folder_name": "features_norm128_v14_fix32",
    "feat_model_name": "dinov2_vitl14_reg",
    "pts_folder_name": "irregular_pts_align_unipts_1p0globalFPS",
    "feat_type": "nonzero_mean_agg_feats",
    "voxelGS_feats_folder_name": "GSandVoxel_feats",
    "ckpt": null,
    "rank": 0,
    "world_size": 1,
    "img_resolution": [1752, 1168],
    "shrinked_frames": 0,
    "frame_step": 10,

    "models": {
        "name": "DensifierV2",
        "args": {
            "model_channels": 1024,
            "voxel_channels": 1024,
            "gswithgrad_channels": 15,
            "num_blocks_GSenc": 1,
            "num_blocks_VoxGSenc": 1,
            "num_blocks_qenc": 6,
            "num_blocks_MCA": 1,
            "num_heads": 4,
            "num_head_channels": 256,
            "mlp_ratio": 4,
            "attn_mode": "full",
            "window_size": 1024,
            "pe_mode": "ptv3pe",
            "use_fp16": false,
            "use_bf16": true,
            "use_checkpoint": true,
            "num_hidden_dims": 4,
            "representation_config": {
                "lr": {
                    "_xyz": 1.0,
                    "_features_dc": 1.0,
                    "_opacity": 1.0,
                    "_scaling": 1.0,
                    "_rotation": 0.1
                },
                "sh_degree": 0,
                "perturb_offset": "none",
                "voxel_size": 0.015625,
                "num_gaussians": 4,
                "2d_filter_kernel_size": 0.1,
                "3d_filter_kernel_size": 9e-4,
                "scaling_bias": [4e-3,1e-3,8e-3],
                "opacity_bias": 0.1,
                "scaling_activation": "softplus"
            },
            "dropout": 0.1
        },
        "voxel_align_ratio": 8
    },

    "trainer":{
        "max_epochs": 1000,
        "batch_size": 1,
        "gradient_clip_val": 1.0,
        
        "render_option": "gsplat",
        "AbsGrad": false,
        "save_img_every_epoch": 4,
        "num_rend_views": 32,
        "sv_option": "fixed",

        "lr": 4e-5,
        "decay": 0.01,
        "use_fp16": false,
        "use_bf16": true,

        "loss_weight_img_rec_l1": 100,
        "loss_weight_img_rec_ssim": 40,
        "loss_weight_img_rec_lpips": 0,
        "loss_weight_kl": 1e-4,
        "loss_weight_opacity": 0.1,
        "loss_weight_scale": 1000000,    
        "loss_weight_depth_l1": 100,

        "out_mlp_lr":{
            "lr_xyz": 1e-4,
            "lr_fdc": 1e-4,
            "lr_sca": 1e-4,
            "lr_rot": 1e-4,
            "lr_opa": 1e-4
        },

        "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 4e-5,
                    "weight_decay": 0.01,
                    "betas": [0.9, 0.98]
                }
            },

        "lr_scheduler": {
            "name": "WarmupCosineAnnealingLR",
            "args": {
                "warmup_steps": 25,
                "max_epochs": 1000,
                "base_lr": 1e-6,
                "max_lr": 4e-5,
                "T_max": 1000
            }
        }  
    }   
}