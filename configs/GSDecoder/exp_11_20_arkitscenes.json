    "NVviewInfo_dir": "/efs-mi-east4-2/datasets/arkitscene_processed_full/Validation_skyup100/novel_view_fix8_viewInfo_normV14",
    "pts_dir": "/efs-mi-east4-2/datasets/arkitscene_processed_full/Validation_skyup100/mapanything_imgonly_v2_64view/ply_pred",
    "depth_dir": "/efs-mi-east4-2/datasets/arkitscene_processed_full/Validation_skyup100/mapanything_imgonly_v2_64view/depth_pred",
    "NVdepth_dir": "/efs-mi-east4-2/datasets/arkitscene_processed_full/Validation_skyup100/mapanything_imgonly_v2_64view/depth_pred_nv8",
    "ckpt": "ckpts/decoder/64views_epoch_0390.ckpt",
    "rank": 0,
    "world_size": 1,
    "img_resolution": [1280, 960], 
    "shrinked_frames": 0,
    "frame_step": 10,
    "view_select": 64,
    "shard_data": true,

    "models": {
        "name": "DecoderOnlyRGBCNNCamDepthInV3",
        "args": {
            "img_resolution": [960, 1280],
            "model_channels": 640,
            "latent_channels": 1024,
            "num_blocks_enc": 16,
            "num_heads": 10,
            "mlp_ratio": 4,
            "attn_mode": "full",
            "window_size": 1024,
            "pe_mode": "ptv3pe",
            "use_fp16": false,
            "use_bf16": true,
            "use_checkpoint": true,
            "num_hidden_dims": 1,
            "bp_acc": 0.03,
            "representation_config": {
                "lr": {
                    "_xyz": 1.0,
                    "_features_dc": 1.0,
                    "_opacity": 1.0,
                    "_scaling": 1.0,
                    "_rotation": 0.1
                },
                "sh_degree": 0,
                "perturb_offset": "none",
                "voxel_size": 0.015625,
                "num_gaussians": 4,
                "2d_filter_kernel_size": 0.1,
                "3d_filter_kernel_size": 9e-4,
                "scaling_bias": [4e-3,8e-3,4e-3],
                "opacity_bias": 0.1,
                "scaling_activation": "softplus"
            },
            "enc_infos": ["rgbOri", "camRay", "depth"],
            "dropout": 0.1
        },
        "voxel_align_ratio": 1
    },

    "trainer":{
        "max_epochs": 5000,
        "batch_size": 1,
        "gradient_clip_val": 1,

        "render_option": "meta_gauss_render",
        "rend_sv_res": [597, 448],
