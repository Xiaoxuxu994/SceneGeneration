        "sv_option": "fixed",

        "lr": 1e-4,
        "decay": 0.01,
        "use_fp16": false,
        "use_bf16": true,

        "loss_weight_img_rec_l1": 200,
        "loss_weight_img_rec_ssim": 40,
        "loss_weight_img_rec_lpips": 40,
        "loss_weight_kl": 1e-4,
        "loss_weight_opacity": 0.01,
        "loss_weight_scale": 100,    
        "loss_weight_depth_l1": 100,

        "out_mlp_lr":{
            "lr_xyz": 1e-4,
            "lr_fdc": 1e-4,
            "lr_sca": 1e-4,
            "lr_rot": 1e-4,
            "lr_opa": 1e-4
        },

        "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 1e-4,
                    "weight_decay": 0.01
                }
            },

        "lr_scheduler": {
            "name": "cosine_scheduler_with_warmup",
            "args": {
                "base_lr": 1e-4,
                "warmup_steps":300,
                "total_steps": 5000,
                "min_lr": 1e-5
            }
        }
